# ═══════════════════════════════════════════════════════════════
# Test environment — DO NOT use for production
# ═══════════════════════════════════════════════════════════════
APP_NAME=DentSpace API (TEST)
APP_ENV=testing
DEBUG=True
API_V1_PREFIX=/api/v1

SECRET_KEY=test-secret-key-with-at-least-32-characters-long-ok
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/dent_space_test
DATABASE_URL_SYNC=postgresql://postgres:admin@localhost:5432/dent_space_test

CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
CLOUDINARY_UPLOAD_PRESET=test

FIREBASE_CREDENTIALS_PATH=./firebase-credentials.nonexistent.json

# SMTP intentionally blank → email_service is a no-op in tests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=DentSpace
OTP_EXPIRE_MINUTES=10

MAX_OTP_ATTEMPTS=5

ALLOWED_ORIGINS=http://localhost:3000

# Disable rate limiting in tests (unless the test enables it)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_DEFAULT=9999/minute
RATE_LIMIT_AUTH=9999/minute